<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AssemblyName>CS2InstantSell</AssemblyName>
		<RootNamespace>CS2InstantSell</RootNamespace>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NuGetAudit>false</NuGetAudit>
		<!-- Folder with the ASF files (ArchiSteamFarm.dll and its dependencies) of the version you run. -->
		<AsfDir Condition="'$(AsfDir)' == ''">$(MSBuildProjectDirectory)/asf</AsfDir>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ArchiSteamFarm"><HintPath>$(AsfDir)/ArchiSteamFarm.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="SteamKit2"><HintPath>$(AsfDir)/SteamKit2.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="AngleSharp"><HintPath>$(AsfDir)/AngleSharp.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="System.Composition.AttributedModel"><HintPath>$(AsfDir)/System.Composition.AttributedModel.dll</HintPath><Private>false</Private></Reference>
	</ItemGroup>
</Project>
